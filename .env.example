APP_NAME=tenders_backend
APP_ENV=local
APP_TIMEZONE=America/Bogota

# Origen permitted por CORS. "*" permite cualquier origen (desarrollo local);
# en produccion debe fijarse al dominio del frontend. Admite una lista
# separada por comas.
CORS_ALLOWED_ORIGIN=*

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tenders
DB_USERNAME=root
DB_PASSWORD=
